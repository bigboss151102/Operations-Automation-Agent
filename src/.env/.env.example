# Copy to src/.env/.env and fill in. src/.env/.env is gitignored; this template is committed.

# --- OpenAI (via LangChain init_chat_model("openai:<model>")) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opspilot-demo

# --- Business rules ---
HIGH_VALUE_THRESHOLD=500
# Fixed "today" so delay calculations match the demo scenarios. Leave empty to use the real date.
REFERENCE_DATE=2026-10-10

# --- Slack operations notifications (optional; leave empty to simulate in the log) ---
# Bot token with scope chat:write; invite the bot to the channel (/invite @OpsPilot).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Comma-separated member IDs tagged on every report, e.g. U0123ABCD,U0456EFGH
SLACK_MENTION_USER_IDS=

# --- App ---
ENV=dev
LOG_LEVEL=INFO
LLM_TIMEOUT_S=60
